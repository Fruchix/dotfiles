setup_omz_plugins() {
    if [[ -z "${ZSH}" ]]; then
        return
    fi

    mkdir -p "$ZSH"/custom/plugins/

    [[ ! -d "$ZSH"/custom/plugins/zsh-autosuggestions ]] && git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH"/custom/plugins/zsh-autosuggestions
    [[ ! -d "$ZSH"/custom/plugins/zsh-syntax-highlighting ]] && git clone https://github.com/zsh-users/zsh-syntax-highlighting "$ZSH"/custom/plugins/zsh-syntax-highlighting
}

setup_omz_themes() {
    if [[ -z "${ZSH}" ]]; then
        return
    fi

    mkdir -p "$ZSH"/custom/themes/

    if [[ ! -d "$ZSH"/custom/themes/catppuccin-flavors ]]; then
        git clone https://github.com/JannoTjarks/catppuccin-zsh.git "$ZSH"/custom/themes/catppuccin-flavors
        command rm "$ZSH"/custom/themes/catppuccin.zsh-theme
        ln -s "$ZSH"/custom/themes/catppuccin-flavors/catppuccin.zsh-theme "$ZSH"/custom/themes/catppuccin.zsh-theme
    fi
}

setup_omz_plugins
setup_omz_themes
unset -f setup_omz_plugins
unset -f setup_omz_themes
