extract() {
    local archive_name="$1"
    local verbose="--verbose"

    if [ -f "$archive_name" ] ; then
        case "$archive_name" in
            *.tar.bz2)  tar xjf "$archive_name" "$verbose"     ;;
            *.tar.gz)   tar xzf "$archive_name" "$verbose"     ;;
            *.bz2)      bunzip2 "$archive_name" "$verbose"     ;;
            *.rar)      rar x "$archive_name" "$verbose"       ;;
            *.gz)       gunzip "$archive_name" "$verbose"      ;;
            *.tar)      tar xf "$archive_name" "$verbose"      ;;
            *.tbz2)     tar xjf "$archive_name" "$verbose"     ;;
            *.tgz)      tar xzf "$archive_name" "$verbose"     ;;
            *.zip)      unzip "$archive_name" "$verbose"       ;;
            *.Z)        uncompress "$archive_name" "$verbose"  ;;
            *.7z)       7z x "$archive_name" "$verbose"        ;;
            *.xz)       xz -d "$archive_name" "$verbose"       ;;
            *)          echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# backup dir as archive
bakarch() {
    local timestamp dest archname
    if [ "$#" -lt 1 ]; then
        echo "Usage: backup_directory <source_directory> [destination_directory]"
        return 1
    fi
    if [ "$#" -lt 2 ]; then
        dest="$(realpath "$1/..")"
    else
        dest="$2"
    fi
    archname=$(realpath "$1")
    archname=${archname##*/}
    timestamp=$(date +%Y%m%d%H%M%S)
    dest="$dest/bak-$archname-$timestamp.tar.gz"
    tar -czf "$dest" "$1"
    echo "Backup of "$archive_name" completed at $dest"
}
