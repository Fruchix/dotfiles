_ssh_agent_start() {
    local ssh_env="${SSH_ENV:-$HOME/.ssh/env}"
    echo -n "Initialising new SSH agent..."
    ssh-agent | sed 's/^echo/#echo/' > "${ssh_env}"
    echo "OK"
    chmod 600 "${ssh_env}"
    . "${ssh_env}" > /dev/null
}

_ssh_agent_connect() {
    local ssh_env="${SSH_ENV:-$HOME/.ssh/env}"
    echo -n "Connecting to existing SSH agent..."
    if [[ -f "${ssh_env}" ]]; then
        . "${ssh_env}" > /dev/null
        if ps -ef | grep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn} ${SSH_AGENT_PID} | grep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn} ssh-agent$ > /dev/null; then
            echo "OK"
        else
            echo "KO"
            _ssh_agent_start
        fi
    else
        echo "KO"
        _ssh_agent_start
    fi
}

ssh-init() {
    command ssh-add -l &> /dev/null
    local agent_status=$?

    # if there is no ssh agent connected in this terminal, then try to connect to one
    if [[ $agent_status -eq 2 ]]; then
        _ssh_agent_connect
    fi

    # get current loaded keys
    local loaded_keys=()
    while IFS= read -r; do
        loaded_keys+=("$REPLY")
    done < <(command ssh-add -L)

    # for each ssh key file that corresponds to a key that is not loaded, then load the key
    local ssh_key_file
    local cur_loaded_key
    local is_ssh_key_file_loaded
    for ssh_key_file in $HOME/.ssh/*.pub; do
        if [[ ! -f "$ssh_key_file" ]]; then
            continue
        fi

        is_ssh_key_file_loaded=0
        for cur_loaded_key in "${loaded_keys[@]}"; do
            if [[ "$cur_loaded_key" == "$(cat "$ssh_key_file")" ]]; then
                is_ssh_key_file_loaded=1
            fi
        done

        if [[ "$is_ssh_key_file_loaded" -eq 0 ]]; then
            command ssh-add "${ssh_key_file%.pub}"
        fi
    done 2>/dev/null
}

ssh-add() {
    command ssh-add -l &> /dev/null

    if [[ $? -eq 2 ]]; then
        _ssh_agent_connect
    fi

    command ssh-add "$@"
}

ssh() {
    command ssh-add -l &> /dev/null
    local agent_status=$?

    if [[ $agent_status -ne 0 ]]; then
        ssh-init
    fi

    command ssh "$@"
}

