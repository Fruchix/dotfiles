_ssh_agent_start() {
    local ssh_env="${SSH_ENV:-$HOME/.ssh/env}"
    echo -n "Initialising new SSH agent..."
    ssh-agent | sed 's/^echo/#echo/' > "${ssh_env}"
    echo "OK"
    chmod 600 "${ssh_env}"
    . "${ssh_env}" > /dev/null
}

_ssh_agent_connect() {
    local ssh_env="${SSH_ENV:-$HOME/.ssh/env}"
    echo -n "Connecting to existing SSH agent..."
    if [[ -f "${ssh_env}" ]]; then
        . "${ssh_env}" > /dev/null
        if ps -ef | grep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn} ${SSH_AGENT_PID} | grep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn} ssh-agent$ > /dev/null; then
            echo "OK"
        else
            echo "KO"
            _ssh_agent_start
        fi
    else
        echo "KO"
        _ssh_agent_start
    fi
}

ssh-add() {
    command ssh-add -l &> /dev/null

    if [[ $? -eq 2 ]]; then
        _ssh_agent_connect
    fi

    command ssh-add "$@"
}

ssh() {
    command ssh-add -l &> /dev/null
    local agent_status=$?

    if [[ $agent_status -eq 2 ]]; then
        _ssh_agent_connect

        command ssh-add -l &> /dev/null
        agent_status=$?
    fi

    local pubkey
    local privkey
    if [[ $agent_status -eq 1 ]]; then
        echo "SSH agent is empty. Checking for available keys..."

        for pubkey in "$HOME"/.ssh/*.pub; do
            [[ -e "$pubkey" ]] || continue

            privkey="${pubkey%.pub}"

            if [[ -f "$privkey" ]]; then
                echo -n "Do you want to add $privkey? [y/N] "
                read -r
                # If the user types y, Y, yes, or YES, add the key
                if [[ "$REPLY" =~ ^([yY][eE][sS]|[yY])$ ]]; then
                    command ssh-add "$privkey"
                fi
            fi
        done
    fi

    command ssh "$@"
}

